DATABASE_URL=postgresql://<db_user>:<db_password>@<db_host>:<db_port>/<db_name>
# Optional direct (non-pooled) URL; migrate/seed/maintenance scripts prefer it over DATABASE_URL (Neon: use it for migrations)
DATABASE_URL_UNPOOLED=
SESSION_TTL_MINUTES=480
PASSWORD_HASH_ITERATIONS=600000
# Required in production: exact frontend origin(s); empty blocks all cross-origin requests. Local dev: CORS_ORIGINS=http://localhost:5173
CORS_ORIGINS=<comma-separated-origins>
# Leave empty in production (set CORS_ORIGINS to the exact frontend URL). Preview-only regex guidance: see README, "Deploying to Vercel + Neon".
CORS_ORIGIN_REGEX=
# Set to true behind Vercel so the client IP comes from X-Forwarded-For
TRUST_PROXY_HEADERS=false
# Generate with: openssl rand -base64 32  (back it up; losing it makes patient identifiers unrecoverable)
PATIENT_DATA_KEY=<32-byte-random-key>
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
ADMIN_USERNAME=admin
ADMIN_EMAIL=<admin-email>
ADMIN_PASSWORD=<at-least-12-chars>
# Demo sandboxes (all optional; defaults shown)
# Contact address shown when a demo account has expired
DEMO_CONTACT_EMAIL=
DEMO_MAX_ACTIVE=500
DEMO_TTL_DAYS=15
DEMO_MAX_PER_HOUR=30
